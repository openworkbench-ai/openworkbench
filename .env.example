OPENROUTER_API_KEY=

# Recommended: supported search API. If both are set, Brave is tried first.
# Without a key, web_search falls back to DuckDuckGo's public results page.
# BRAVE_SEARCH_API_KEY=
# TAVILY_API_KEY=

# Accounts are email + password. The first account to sign up always works and
# inherits any apps that already exist; after that, sign-ups are closed unless
# you opt in here (each account can spend your model credits).
ALLOW_SIGNUP=false

# Built-in email/password accounts and sessions. Defaults to data/auth.db.
# AUTH_DB_PATH=
# Which user owns which app (independent of the auth provider). Defaults to
# ownership.db next to AUTH_DB_PATH.
# OWNERSHIP_DB_PATH=

# Durable app drafts, source revisions and app conversations. Defaults to
# workspaces/ next to AUTH_DB_PATH. Keep this directory on a persistent volume.
# WORKSPACES_DIR=
