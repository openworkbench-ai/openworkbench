OPENROUTER_API_KEY=

# Accounts are email + password. The first account to sign up always works and
# inherits any apps that already exist; after that, sign-ups are closed unless
# you opt in here (each account can spend your model credits).
ALLOW_SIGNUP=false

# Built-in email/password accounts and sessions. Defaults to data/auth.db.
# AUTH_DB_PATH=
# Which user owns which app (independent of the auth provider). Defaults to
# ownership.db next to AUTH_DB_PATH.
# OWNERSHIP_DB_PATH=
