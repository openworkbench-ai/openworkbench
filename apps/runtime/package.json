{
  "name": "openworkbench-runtime",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "cd ../.. && tsx --env-file-if-exists=.env apps/runtime/agent.ts",
    "server": "cd ../.. && tsx --env-file-if-exists=.env apps/runtime/server.ts",
    "test": "cd ../.. && node --import tsx --test apps/runtime/*.test.ts apps/runtime/**/*.test.ts",
    "browser:install": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium --only-shell"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mozilla/readability": "^0.6.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.65.0",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "typebox": "^1.3.22"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
