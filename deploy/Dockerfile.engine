FROM golang:1.26-alpine AS build
RUN apk add --no-cache curl unzip
WORKDIR /src
COPY scripts/setup-python-wasm.sh scripts/setup-python-wasm.sh
RUN sh scripts/setup-python-wasm.sh /python-wasm
COPY engine/go.mod engine/go.sum ./
RUN go mod download
COPY engine/ ./
RUN CGO_ENABLED=0 go build -o /out/pocketknife ./cmd/pocketknife

FROM alpine:3.20
RUN apk add --no-cache ca-certificates && adduser -D -u 10001 pocketknife
COPY --from=build /out/pocketknife /usr/local/bin/pocketknife
COPY --from=build /python-wasm /opt/python-wasm
ENV POCKETKNIFE_PYTHON_DIR=/opt/python-wasm
# The shipped example app. Not served from here -- the catalog is always a
# mounted volume -- but deployments copy it into an empty catalog on first run.
COPY catalog/hyrox /usr/share/openworkbench/default-catalog/hyrox
USER pocketknife
EXPOSE 8080
ENTRYPOINT ["pocketknife"]
CMD ["-addr", "0.0.0.0:8080", "-catalog", "/catalog", "-data", "/data"]
