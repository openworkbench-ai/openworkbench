FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/runtime/package.json apps/runtime/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/app-ui-kit/package.json packages/app-ui-kit/package.json
RUN npm ci

FROM deps AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip ca-certificates && rm -rf /var/lib/apt/lists/*
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN npx playwright install --with-deps chromium --only-shell && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY apps/runtime apps/runtime
COPY packages/app-ui-kit packages/app-ui-kit
COPY packages/workspace-chat.ts packages/workspace-chat.ts
COPY pi pi
EXPOSE 8787
CMD ["npx", "tsx", "apps/runtime/server.ts"]
