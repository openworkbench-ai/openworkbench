{
  "name": "@openworkbench/app-ui-kit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Fixed infra for app-rendered MCP Apps components: the App-bridge bootstrap, a trimmed design-system primitive set, and the build/codegen tools that turn an app's ui/components/*.tsx into served MCP Apps resources. Not agent-authored.",
